# Konfigurasi API Crypto (FreeCryptoAPI)
VITE_FREE_CRYPTO_API_KEY=your_free_crypto_api_key_here
VITE_FREE_CRYPTO_BASE_URL=https://api.freecryptoapi.com/v1

# Endpoint Kurs USD ke IDR (Exchange API Fawaz Ahmed)
VITE_EXCHANGE_RATE_URL=https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1/currencies/usd.json

# Konfigurasi Supabase (PostgreSQL & Supabase Auth)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
